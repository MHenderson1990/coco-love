{
  "expo": {
    "name": "Love G.E.M.S.",
    "slug": "love-gems",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.coco.houseoflove",
      "buildNumber": "3",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "Love G.E.M.S"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
        "plugins": [
      [
      "expo-image-picker",
        {
          "photosPermission": "House of Love needs access to your library so you can upload sessions."
        }
      ],
      "expo-video",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "House of Love uses Face ID to securely unlock your account."
        }
      ],
      [
    "expo-audio",
        {
          "microphonePermission": "House of Love uses the microphone so you can record voice journal entries."
        }
      ],
      [
        "@bacons/apple-targets",
        {
          "appleTeamId": "BV8FDM3UB2"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d70c1ebb-cfaa-406b-b627-8402c396e584"
      }
    }
  }
}
